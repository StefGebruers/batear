# Board: Heltec WiFi LoRa 32 V4 (ESP32-S3, 16 MB Flash, OLED, LED)
CONFIG_BATEAR_BOARD_HELTEC_V4=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Role: Wi-Fi Detector (1 I2S Mic + Wi-Fi + MQTT + OLED + HA Auto-Discovery)
CONFIG_BATEAR_ROLE_WIFI_DETECTOR=y
CONFIG_BATEAR_DEVICE_ID=1
CONFIG_BATEAR_AUDIO_DEBUG_LOG=y

# MQTT / Home Assistant (can also be set at runtime via USB serial console)
CONFIG_BATEAR_WIFI_SSID=""
CONFIG_BATEAR_WIFI_PASS=""
CONFIG_BATEAR_MQTT_BROKER_URL="mqtt://192.168.1.76:1883"
CONFIG_BATEAR_MQTT_USER=""
CONFIG_BATEAR_MQTT_PASS=""
CONFIG_BATEAR_WIFI_DEVICE_ID="det01"

# REST API / OTA
CONFIG_BATEAR_HTTP_PORT=8080
CONFIG_BATEAR_HTTP_AUTH_TOKEN=""

# Avoid GCC macro-prefix-map bug when project directory path contains spaces
# CONFIG_COMPILER_HIDE_PATHS_MACROS is not set

